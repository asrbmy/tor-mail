# Copy to /etc/tormail/update.env (chmod 600, owned by root). Plain KEY=value lines, no spaces around "=".

# Where releases come from.
REPO_URL=https://github.com/asrbmy/tor-mail.git
# tags   = install the newest tag named vX.Y.Z (recommended: you decide when something becomes a release)
# branch = install whatever is at the tip of BRANCH
CHANNEL=tags
BRANCH=main

# Signature checking. Leave this at 1. Setting 0 lets anyone who controls the GitHub account deploy code to your server
# and to your users' browsers.
REQUIRE_SIGNED=1
# openpgp (default): GNUPGHOME must hold ONLY the public release key(s) you trust.
SIGNING_FORMAT=openpgp
GNUPGHOME=/etc/tormail/gnupg
# ssh: set SIGNING_FORMAT=ssh and list the trusted keys in ALLOWED_SIGNERS (format: see "ALLOWED SIGNERS" in ssh-keygen(1)).
#ALLOWED_SIGNERS=/etc/tormail/allowed_signers

# Encrypted backup taken before every update (needs the "age" tool). Strongly recommended.
AGE_RECIPIENT=age1replace_with_your_age_public_key
BACKUP_DIR=/var/backups/tormail
BACKUP_KEEP=7
#SKIP_BACKUP=1

# How long to wait for the app container to report healthy before rolling back.
HEALTH_TIMEOUT=180
